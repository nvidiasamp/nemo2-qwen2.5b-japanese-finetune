# NeMo2 Qwen2.5B Japanese Fine-tuning Environment Variables

# HuggingFace Token (Required for downloading models from HuggingFace Hub)
HUGGINGFACE_TOKEN="your_huggingface_token_here"           # Format: hf_...

# Weights & Biases API Key (Optional, for experiment tracking)
WANDB_API_KEY="your_wandb_api_key_here"                   # Optional: For logging experiments

# NVIDIA NGC API Key (Optional, for downloading NeMo models from NGC)
NGC_API_KEY="your_ngc_api_key_here"                       # Optional: Format: nvapi-...

# Training Configuration (Optional, can also be set in config files)
# NEMO_CHECKPOINT_DIR="/path/to/checkpoints"              # Directory for saving checkpoints
# NEMO_DATA_DIR="/path/to/data"                           # Directory containing training data
# CUDA_VISIBLE_DEVICES="0,1,2,3"                          # GPUs to use for training
